root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

[*.{kt,kts,gradle}]
indent_size = 4

[*.{java,xml}]
indent_size = 4

[*.{js,jsx,ts,tsx,json,jsonc,yml,yaml,css,scss}]
indent_size = 2

[*.{md,markdown}]
trim_trailing_whitespace = false
indent_size = 2

[*.{sh,bash}]
indent_size = 2

[*.bat]
end_of_line = crlf

[Makefile]
indent_style = tab
